import { useRef, useState } from "react";
import "./index.css";

const API_URL = "http://127.0.0.1:5000";

function App() {
  const fileInputRef = useRef(null);

  const [file, setFile] = useState(null);
  const [preview, setPreview] = useState("");
  const [result, setResult] = useState("");
  const [isDragging, setIsDragging] = useState(false);
  const [isProcessing, setIsProcessing] = useState(false);
  const [error, setError] = useState("");

  // -----------------------------
  // HANDLE SELECTED IMAGE
  // -----------------------------
  const handleFile = (selectedFile) => {
    setError("");
    setResult("");

    if (!selectedFile) {
      return;
    }

    // Check image type
    if (!selectedFile.type.startsWith("image/")) {
      setError("Please select a valid image file.");
      return;
    }

    // Maximum 10 MB
    if (selectedFile.size > 10 * 1024 * 1024) {
      setError("Image size must be less than 10 MB.");
      return;
    }

    // Remove old preview URL
    if (preview) {
      URL.revokeObjectURL(preview);
    }

    const imageURL = URL.createObjectURL(selectedFile);

    setFile(selectedFile);
    setPreview(imageURL);
  };

  // -----------------------------
  // BROWSE IMAGE
  // -----------------------------
  const handleBrowse = () => {
    fileInputRef.current?.click();
  };

  // -----------------------------
  // FILE INPUT
  // -----------------------------
  const handleInputChange = (event) => {
    const selectedFile = event.target.files?.[0];

    handleFile(selectedFile);
  };

  // -----------------------------
  // DRAG OVER
  // -----------------------------
  const handleDragOver = (event) => {
    event.preventDefault();
    setIsDragging(true);
  };

  // -----------------------------
  // DRAG LEAVE
  // -----------------------------
  const handleDragLeave = () => {
    setIsDragging(false);
  };

  // -----------------------------
  // DROP IMAGE
  // -----------------------------
  const handleDrop = (event) => {
    event.preventDefault();

    setIsDragging(false);

    const droppedFile = event.dataTransfer.files?.[0];

    handleFile(droppedFile);
  };

  // -----------------------------
  // COLORIZE IMAGE
  // -----------------------------
  const colorizeImage = async () => {
    if (!file) {
      setError("Please select an image first.");
      return;
    }

    try {
      setError("");
      setResult("");
      setIsProcessing(true);

      // Create FormData
      const formData = new FormData();

      // IMPORTANT:
      // Flask backend expects "image"
      formData.append("image", file);

      console.log("Sending image to ColorFusion AI...");

      // Send image to Flask backend
      const response = await fetch(`${API_URL}/api/colorize`, {
        method: "POST",
        body: formData,
      });

      // Handle backend error
      if (!response.ok) {
        let message = "Colorization failed.";

        try {
          const data = await response.json();

          if (data.error) {
            message = data.error;
          }
        } catch {
          // Response wasn't JSON
        }

        throw new Error(message);
      }

      // Get colorized image
      const blob = await response.blob();

      // Create browser URL
      const resultURL = URL.createObjectURL(blob);

      setResult(resultURL);

      console.log("Colorization completed successfully!");
    } catch (error) {
      console.error("Colorization error:", error);

      if (error.name === "TypeError") {
        setError(
          "Cannot connect to ColorFusion AI backend. Make sure python app.py is running.",
        );
      } else {
        setError(error.message || "Something went wrong.");
      }
    } finally {
      setIsProcessing(false);
    }
  };

  // -----------------------------
  // REMOVE IMAGE
  // -----------------------------
  const removeImage = () => {
    if (preview) {
      URL.revokeObjectURL(preview);
    }

    if (result) {
      URL.revokeObjectURL(result);
    }

    setFile(null);
    setPreview("");
    setResult("");
    setError("");

    if (fileInputRef.current) {
      fileInputRef.current.value = "";
    }
  };

  // -----------------------------
  // DOWNLOAD RESULT
  // -----------------------------
  const downloadResult = () => {
    if (!result) {
      return;
    }

    const link = document.createElement("a");

    link.href = result;
    link.download = "colorfusion-colorized.jpg";

    document.body.appendChild(link);

    link.click();

    document.body.removeChild(link);
  };

  return (
    <div className="app">
      {/* ======================================
          NAVBAR
      ====================================== */}
      <header className="navbar">
        <div className="logo">
          <div className="logo-icon">✦</div>

          <span>ColorFusion</span>
        </div>

        <div className="badge">AI IMAGE COLORIZATION</div>
      </header>

      {/* ======================================
          MAIN
      ====================================== */}
      <main>
        {/* ====================================
            HERO
        ==================================== */}
        <section className="hero">
          <p className="eyebrow">RESTORE • REVIVE • REIMAGINE</p>

          <h1>
            Bring your old photos
            <span>back to color.</span>
          </h1>

          <p className="description">
            Transform black and white memories into vibrant color using AI.
          </p>
        </section>

        {/* ====================================
            UPLOAD AREA
        ==================================== */}
        {!file && (
          <section className="upload-section">
            <div
              className={`drop-zone ${isDragging ? "dragging" : ""}`}
              onClick={handleBrowse}
              onDragOver={handleDragOver}
              onDragLeave={handleDragLeave}
              onDrop={handleDrop}
            >
              <div className="upload-icon">↑</div>

              <h2>Drop your image here</h2>

              <p>or click to browse</p>

              <small>JPG • PNG • WEBP • Maximum 10 MB</small>

              <input
                ref={fileInputRef}
                type="file"
                accept="image/*"
                hidden
                onChange={handleInputChange}
              />
            </div>
          </section>
        )}

        {/* ====================================
            IMAGE WORKSPACE
        ==================================== */}
        {file && (
          <section className="workspace">
            {/* ==================================
                ORIGINAL IMAGE
            ================================== */}
            <div className="image-card">
              <div className="card-header">
                <div>
                  <small>ORIGINAL</small>

                  <h3>{file.name}</h3>
                </div>

                <button
                  className="remove-button"
                  onClick={removeImage}
                  title="Remove image"
                >
                  ×
                </button>
              </div>

              <div className="image-preview">
                <img src={preview} alt="Original uploaded image" />
              </div>
            </div>

            {/* ==================================
                AI RESULT
            ================================== */}
            <div className="image-card">
              <div className="card-header">
                <div>
                  <small>COLORFUSION AI</small>

                  <h3>{result ? "Colorized Image" : "AI Result"}</h3>
                </div>
              </div>

              <div className="image-preview result-preview">
                {result ? (
                  <img src={result} alt="AI colorized result" />
                ) : (
                  <div className="result-placeholder">
                    <span>✦</span>

                    <p>Your colorized image will appear here</p>
                  </div>
                )}
              </div>
            </div>
          </section>
        )}

        {/* ====================================
            ACTION BUTTONS
        ==================================== */}
        {file && (
          <section className="actions">
            {!result && (
              <button
                className="colorize-button"
                onClick={colorizeImage}
                disabled={isProcessing}
              >
                {isProcessing ? (
                  <>
                    <span className="spinner"></span>
                    Colorizing...
                  </>
                ) : (
                  <>✦ Colorize with AI</>
                )}
              </button>
            )}

            {result && (
              <button className="download-button" onClick={downloadResult}>
                ↓ Download Colorized Image
              </button>
            )}
          </section>
        )}

        {/* ====================================
            ERROR
        ==================================== */}
        {error && <div className="error">⚠️ {error}</div>}

        {/* ====================================
            FEATURES
        ==================================== */}
        <section className="features">
          <div className="feature">
            <strong>01</strong>

            <h3>Upload</h3>

            <p>Drag and drop your black and white photo.</p>
          </div>

          <div className="feature">
            <strong>02</strong>

            <h3>AI Colorization</h3>

            <p>Our AI predicts natural colors for your image.</p>
          </div>

          <div className="feature">
            <strong>03</strong>

            <h3>Download</h3>

            <p>Download your colorized image instantly.</p>
          </div>
        </section>
      </main>

      {/* ======================================
          FOOTER
      ====================================== */}
      <footer>© 2026 ColorFusion AI</footer>
    </div>
  );
}

export default App;
